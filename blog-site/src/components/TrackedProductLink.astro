---
interface Props {
  destination: 'dashboard' | 'api' | 'mcp';
  href?: string;
  placement: string;
  campaign?: string;
  class?: string;
}

const {
  destination,
  href,
  class: className,
} = Astro.props;
const publicUrls = {
  dashboard: '/',
  api: '/openapi.yaml',
  mcp: '/docs/mcp',
};
const linkHref = href ?? publicUrls[destination];
---

<a
  href={linkHref}
  class={className}
  target="_blank"
  rel="noopener noreferrer"
>
  <slot />
</a>
